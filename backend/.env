# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=od-management-secret-key-2025

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:Kavin04@localhost:5432/OD
DEV_DATABASE_URL=postgresql://postgres:Kavin04@localhost:5432/OD
TEST_DATABASE_URL=postgresql://postgres:Kavin04@localhost:5432/OD_test

# JWT Configuration
JWT_SECRET_KEY=jwt-secret-od-management-2025

# Email Configuration (Gmail SMTP) - Update with your email
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=OD Management System <your-email@gmail.com>

# Tesseract OCR Path (Windows)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Redis URL for rate limiting
REDIS_URL=redis://localhost:6379