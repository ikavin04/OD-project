# Production Environment Configuration Template
# Copy this file to .env in your backend directory and update the values

# ============================================================================
# FLASK CONFIGURATION
# ============================================================================
FLASK_ENV=production
FLASK_DEBUG=False
SECRET_KEY=your-secret-key-here-use-openssl-rand-hex-32
JWT_SECRET_KEY=your-jwt-secret-key-here-use-openssl-rand-hex-32

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
DATABASE_URL=postgresql://od_user:OD_secure_2024!@localhost/od_management

# ============================================================================
# EMAIL CONFIGURATION
# ============================================================================
# Gmail SMTP Configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password-here
MAIL_DEFAULT_SENDER=your-email@gmail.com

# Alternative SMTP providers:
# 
# SendGrid:
# MAIL_SERVER=smtp.sendgrid.net
# MAIL_PORT=587
# MAIL_USERNAME=apikey
# MAIL_PASSWORD=your-sendgrid-api-key
#
# Mailgun:
# MAIL_SERVER=smtp.mailgun.org
# MAIL_PORT=587
# MAIL_USERNAME=your-mailgun-smtp-username
# MAIL_PASSWORD=your-mailgun-smtp-password

# ============================================================================
# FILE UPLOAD CONFIGURATION
# ============================================================================
UPLOAD_FOLDER=/var/www/od-management/uploads
MAX_CONTENT_LENGTH=16777216

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================
# Update with your actual domain
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================
LOG_LEVEL=INFO
LOG_FILE=/var/www/od-management/logs/app.log

# ============================================================================
# RATE LIMITING
# ============================================================================
RATELIMIT_STORAGE_URL=redis://localhost:6379

# ============================================================================
# MONITORING (Optional)
# ============================================================================
# Sentry for error tracking
# SENTRY_DSN=your-sentry-dsn-here

# ============================================================================
# BACKUP CONFIGURATION
# ============================================================================
BACKUP_RETENTION_DAYS=30
BACKUP_LOCATION=/var/www/od-management/backups

# ============================================================================
# ADDITIONAL SECURITY
# ============================================================================
# Session timeout in seconds (24 hours)
PERMANENT_SESSION_LIFETIME=86400

# JWT token expiration (1 hour)
JWT_ACCESS_TOKEN_EXPIRES=3600