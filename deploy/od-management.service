[Unit]
Description=OD Management System Backend
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=exec
User=odapp
Group=www-data
WorkingDirectory=/var/www/od-management/backend
Environment=PATH=/var/www/od-management/backend/venv/bin
EnvironmentFile=/var/www/od-management/backend/.env
ExecStart=/var/www/od-management/backend/venv/bin/gunicorn --config gunicorn.conf.py main:app
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=5
PrivateTmp=true
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target